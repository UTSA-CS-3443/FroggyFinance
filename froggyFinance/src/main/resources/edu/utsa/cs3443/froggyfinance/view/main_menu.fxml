    <children>
        <VBox alignment="CENTER" layoutX="193.0" layoutY="96.0" spacing="20.0">
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Froggy Finance!" />
            <Button fx:id="startGameButton" onAction="#handleStartGame" prefWidth="200" text="Start Game" />
