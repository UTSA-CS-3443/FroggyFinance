<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.utsa.cs3443.froggyfinance.controller.SettingsController"
            prefHeight="400.0" prefWidth="600.0">

    <!-- Title -->
    <Label text="Settings" layoutX="260" layoutY="40" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Volume Slider -->
    <Label text="Volume:" layoutX="175" layoutY="100"/>
    <Slider fx:id="volumeSlider" layoutX="175" layoutY="120" prefWidth="233" min="0" max="100" value="50"/>

    <!-- Save button -->
    <Button text="Save" layoutX="220" layoutY="300" onAction="#handleSave"/>

    <!-- Go Back button -->
    <Button text="Go Back" layoutX="320" layoutY="300" onAction="#switchToMainMenu"/>

</AnchorPane>
